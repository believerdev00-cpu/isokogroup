# Copy to .env for local development. Never commit real secrets.

# ---- Website (public: these end up in the browser bundle) ----
# The Supabase project URL and its publishable "anon" key. Row-level security
# is what protects the data; never put the service-role key here.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Edge Functions (server only: set as Supabase function secrets) ----
# `supabase secrets set NAME=value`. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# are provided to functions automatically.

# payments-webhook: the mock provider, for development and tests only. Leave
# unset in production. At least 16 characters.
PAYMENTS_MOCK_SECRET=

# notifications-dispatch: who sends email, WhatsApp and SMS. A channel without
# a provider is not sent (its messages are marked skipped). Email: "smtp" with the
# SMTP_* settings below (this also sends the Training Center's emails). WhatsApp
# and SMS: only "mock" until real providers are added in
# supabase/functions/notifications-dispatch/channels.ts.
EMAIL_PROVIDER=
EMAIL_FROM="Isoko <no-reply@isoko.rw>"
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
