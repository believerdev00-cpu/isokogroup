# Copy to .env for local development. Never commit real secrets.

# ---- Website (public: these end up in the browser bundle) ----
# The Supabase project URL and its publishable "anon" key. Row-level security
# is what protects the data; never put the service-role key here.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Edge Functions (server only: set as Supabase function secrets) ----
# `supabase secrets set NAME=value`. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# are provided to functions automatically.

# training (the Training Center API, built from training-api/): required on
# hosted Supabase, where it refuses to start without them.
#   SITE_ORIGINS: the site addresses allowed to call it from a browser, comma separated
#   PUBLIC_SITE_URL: the site address used in links (emails, certificates), no trailing slash
SITE_ORIGINS=https://isokogroups.com,https://www.isokogroups.com
PUBLIC_SITE_URL=https://isokogroups.com
# Optional: a pooler connection string for the API (defaults to SUPABASE_DB_URL),
# the private Storage bucket for its files, and the upload size limit in MB.
TRAINING_DB_URL=
TRAINING_STORAGE_BUCKET=training
MAX_UPLOAD_MB=8

# payments-webhook: the mock provider, for local development and tests only
# (at least 16 characters). Hosted Supabase never enables it, even if set.
PAYMENTS_MOCK_SECRET=

# payments-itecpay: paying from the phone through ItecPay (docs/ITECPAY_INTEGRATION.md).
# The keys from ItecPay's portal (Integrations > API keys), set only as Supabase
# secrets; a network without a key isn't offered. The callback secret is 32+
# random characters, the end of the callback address given to ItecPay.
ITECPAY_KEY_MTN=
ITECPAY_KEY_AIRTEL=
ITECPAY_KEY_SPENN=
ITECPAY_CALLBACK_SECRET=

# notifications-dispatch: who sends email, WhatsApp and SMS. A channel without
# a provider is not sent (its messages are marked skipped). Email: "smtp" with the
# SMTP_* settings below (this also sends the Training Center's emails); with
# Resend: SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASSWORD=<API key>.
# WhatsApp and SMS: "twilio" with the TWILIO_* settings below.
EMAIL_PROVIDER=
EMAIL_FROM="Isoko <no-reply@isokogroups.com>"
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
WHATSAPP_PROVIDER=
SMS_PROVIDER=
# Twilio Console > Account info. The auth token is a password: Supabase secrets only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sender, e.g. whatsapp:+14155238886 (Twilio's sandbox) or your approved number
TWILIO_WHATSAPP_FROM=
# SMS sender: a number, an approved sender name, or a Messaging Service SID (MG...)
TWILIO_SMS_FROM=
